# Spring Boot backend environment template
# Copy to your environment manager (Render/terminal), do NOT commit real secrets.

# Required
SPRING_DATA_MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/photfolioDb?retryWrites=true&w=majority&appName=Cluster0
JWT_SECRET=<64_plus_character_secret>

# Optional (only if you want initial admin seed when user does not exist)
APP_ADMIN_EMAIL=
APP_ADMIN_PASSWORD=

# Optional (mail features)
MAIL_USERNAME=
MAIL_APP_PASSWORD=

# OTP storage (use redis in production, memory for local development)
APP_OTP_STORE=memory
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false

# Optional (for absolute media URLs if needed)
APP_BASE_URL=

# Storage provider (local | supabase)
APP_STORAGE_PROVIDER=local
APP_STORAGE_UPLOAD_DIR=

# Supabase Storage (required only when APP_STORAGE_PROVIDER=supabase)
APP_STORAGE_SUPABASE_URL=
APP_STORAGE_SUPABASE_SERVICE_KEY=
APP_STORAGE_SUPABASE_BUCKET=
APP_STORAGE_SUPABASE_FOLDER=gallery
