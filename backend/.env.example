# Spring Boot backend environment template
# Copy to your environment manager (Render/terminal), do NOT commit real secrets.

# Required
SPRING_DATA_MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/photfolioDb?retryWrites=true&w=majority&appName=Cluster0
JWT_SECRET=<64_plus_character_secret>

# Optional (only if you want initial admin seed when user does not exist)
APP_ADMIN_EMAIL=
APP_ADMIN_PASSWORD=

# Optional (mail features)
MAIL_USERNAME=
MAIL_APP_PASSWORD=

# Optional (for absolute media URLs if needed)
APP_BASE_URL=
